    {% if channel == 'messenger' %}
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor"  d="M0 7.76C0 3.301 3.493 0 8 0s8 3.301 8 7.76s-3.493 7.76-8 7.76c-.81 0-1.586-.107-2.316-.307a.64.64 0 0 0-.427.03l-1.588.702a.64.64 0 0 1-.898-.566l-.044-1.423a.64.64 0 0 0-.215-.456C.956 12.108 0 10.092 0 7.76m5.546-1.459l-2.35 3.728c-.225.358.214.761.551.506l2.525-1.916a.48.48 0 0 1 .578-.002l1.869 1.402a1.2 1.2 0 0 0 1.735-.32l2.35-3.728c.226-.358-.214-.761-.551-.506L9.728 7.381a.48.48 0 0 1-.578.002L7.281 5.98a1.2 1.2 0 0 0-1.735.32z"/></svg>
    {% elseif channel == 'instagram' %}
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor"  d="M8 0C5.829 0 5.556.01 4.703.048C3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7C.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297c.04.852.174 1.433.372 1.942c.205.526.478.972.923 1.417c.444.445.89.719 1.416.923c.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417c.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046c.78.035 1.204.166 1.486.275c.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485c.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598c-.28.11-.704.24-1.485.276c-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598a2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485c-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486c.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276c.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92a.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217a4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334a2.667 2.667 0 0 1 0-5.334"/></svg>
    {% else %}
        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8 9h8M8 13h6M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-5l-5 3v-3H6a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3z"/></svg>
    {% endif %}
{% endmacro %}

{% macro brand_color(channel) -%}
    {{- {'messenger': '#0084FF', 'instagram': '#C13584'}[channel]|default('#667382') -}}
{%- endmacro %}

{% macro avatar(image_url, channel, label, size = 40) %}
    {% import _self as marks %}
    {% set color = marks.brand_color(channel) %}
    <span class="d-inline-flex position-relative flex-shrink-0" style="width:{{ size }}px;height:{{ size }}px;">
        {# Meta's picture URLs are signed and expire; the mark stands in when one no longer loads. #}
        <span class="d-inline-flex align-items-center justify-content-center rounded-circle w-100 h-100"
              style="background:{{ color }}1a;color:{{ color }};border:1px solid {{ color }}40;font-size:{{ (size * 0.45)|round }}px;">
            {{ marks.mark(channel) }}
        </span>
        {% if image_url starts with 'http' %}
            <img src="{{ image_url }}" alt="{{ label }}" loading="lazy" referrerpolicy="no-referrer"
                 class="position-absolute top-0 start-0 w-100 h-100 rounded-circle" style="object-fit:cover;"
                 onerror="this.remove();">
        {% endif %}
    </span>
{% endmacro %}

{% macro channel_badge(channel) %}
    {% import _self as marks %}
    {% set color = marks.brand_color(channel) %}
    <span class="badge d-inline-flex align-items-center gap-1 text-white" style="background:{{ color }};">
        {{ marks.mark(channel) }}
        {{ ('sylius_bot.ui.' ~ channel)|trans }}
    </span>
{% endmacro %}

{% macro delivery_badge(state) %}
    {% set classes = {
        'ok': 'bg-green-lt',
        'token_invalid': 'bg-red-lt',
        'not_subscribed': 'bg-orange-lt',
    } %}
    <span class="badge {{ classes[state]|default('bg-secondary-lt') }}" title="{{ ('sylius_bot.ui.delivery.' ~ state ~ '_help')|trans }}">
        {{ ('sylius_bot.ui.delivery.' ~ state)|trans }}
    </span>
{% endmacro %}
