{% set rows = [
    {label: 'sylius_bot.ui.first_name', value: subscriber.firstName},
    {label: 'sylius_bot.ui.last_name', value: subscriber.lastName},
    {label: 'sylius_bot.ui.platform_id', value: subscriber.botSubscriberId},
    {label: 'sylius_bot.ui.page', value: subscriber.bot ? subscriber.bot.pageName : null},
    {label: 'sylius_bot.ui.locale', value: subscriber.locale},
    {label: 'sylius_bot.ui.timezone', value: subscriber.timezone},
] %}

<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius.ui.details'|trans }}</h3>
    </div>
    <div class="card-body">
        <div class="divide-y">
            {% for row in rows %}
                <div class="row">
                    <div class="col-12 col-md-5 fw-bold">{{ row.label|trans }}</div>
                    <div class="col-12 col-md-7 text-break">
                        {# 1.x stored a literal "NONE" for fields the platform does not expose. #}
                        {% if row.value is empty or row.value|upper == 'NONE' %}<span class="text-secondary">-</span>{% else %}{{ row.value }}{% endif %}
                    </div>
                </div>
            {% endfor %}
            <div class="row">
                <div class="col-12 col-md-5 fw-bold">{{ 'sylius_bot.ui.first_message'|trans }}</div>
                <div class="col-12 col-md-7">{{ subscriber.createdAt ? subscriber.createdAt|format_datetime('medium', 'short') : '-' }}</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">{{ 'sylius.ui.customer'|trans }}</h3>
    </div>
    <div class="card-body">
        {% if customer %}
            <div class="divide-y">
                <div class="row">
                    <div class="col-12 col-md-5 fw-bold">{{ 'sylius.ui.name'|trans }}</div>
                    <div class="col-12 col-md-7 text-break">
                        <a href="{{ path('sylius_admin_customer_show', {id: customer.id}) }}">{{ customer.fullName|trim|default(customer.email) }}</a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-5 fw-bold">{{ 'sylius.ui.email'|trans }}</div>
                    <div class="col-12 col-md-7 text-break">{{ customer.email|default('-') }}</div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-5 fw-bold">{{ 'sylius.ui.phone_number'|trans }}</div>
                    <div class="col-12 col-md-7 text-break">{{ customer.phoneNumber|default('-') }}</div>
                </div>
            </div>
        {% else %}
            <span class="text-secondary">{{ 'sylius_bot.ui.no_customer'|trans }}</span>
        {% endif %}
    </div>
</div>
