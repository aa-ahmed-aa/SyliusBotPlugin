<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="SyliusBotPlugin\Entity\Bot" table="sylius_bot_plugin_bot">
        <unique-constraints>
            <unique-constraint name="sylius_bot_plugin_bot_channel_page_idx" columns="channel_type,page_id"/>
        </unique-constraints>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="pageName" column="page_name" type="string" length="255" nullable="true"/>
        <field name="pageId" column="page_id" type="string" length="191" nullable="true"/>
        <field name="pageAccessToken" column="page_access_token" type="text" nullable="true"/>
        <field name="pageImageUrl" column="page_image_url" type="text" nullable="true"/>
        <field name="channelType" column="channel_type" type="string" length="32" nullable="true"/>
        <field name="facebookPageId" column="facebook_page_id" type="string" length="191" nullable="true"/>
        <field name="disabled" column="disabled" type="boolean">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="settings" column="persistent_menu" type="text" nullable="true"/>

        <field name="createdAt" column="created_at" type="datetime" nullable="true">
            <gedmo:timestampable on="create"/>
        </field>
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>
    </mapped-superclass>
</doctrine-mapping>
